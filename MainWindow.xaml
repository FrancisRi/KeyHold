<Window
    x:Class="KeyHoldMacro.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>
    <Grid x:Name="Shell" RowDefinitions="Auto,*">
        <TitleBar x:Name="AppTitleBar" Title="KeyHold" AutomationProperties.AutomationId="AppTitleBar">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="ms-appx:///assets/KeyHold.ico" />
            </TitleBar.IconSource>
        </TitleBar>
        <Grid x:Name="Root" Grid.Row="1" Padding="24,12,24,18" RowSpacing="14" RowDefinitions="Auto,*,Auto">
            <Grid.Resources>
                <Style x:Key="Card" TargetType="Border">
                    <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                    <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="CornerRadius" Value="8" />
                    <Setter Property="Padding" Value="16" />
                </Style>
                <Style x:Key="SectionHeading" TargetType="TextBlock">
                    <Setter Property="FontSize" Value="18" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="AutomationProperties.HeadingLevel" Value="Level2" />
                </Style>
                <Style x:Key="CommandButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                    <Setter Property="MinHeight" Value="34" />
                    <Setter Property="Padding" Value="12,5" />
                    <Setter Property="HorizontalAlignment" Value="Stretch" />
                </Style>
                <Style x:Key="SecondaryText" TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Setter Property="FontSize" Value="12" />
                    <Setter Property="TextWrapping" Value="Wrap" />
                </Style>
            </Grid.Resources>
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="16">
                <StackPanel Spacing="3">
                    <TextBlock x:Name="Heading" FontSize="28" FontWeight="SemiBold" AutomationProperties.HeadingLevel="Level1" />
                    <TextBlock x:Name="Shortcuts" Style="{StaticResource SecondaryText}" />
                </StackPanel>
                <Border Grid.Column="1" VerticalAlignment="Center" Padding="12,6" CornerRadius="14"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                    <TextBlock x:Name="RunState" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite"
                               AutomationProperties.AutomationId="RunState" />
                </Border>
                <ComboBox x:Name="LanguageChoice" Grid.Column="2" Width="120" VerticalAlignment="Center"
                          AutomationProperties.Name="Language / 语言" AutomationProperties.AutomationId="Language">
                    <x:String>简体中文</x:String>
                    <x:String>English</x:String>
                </ComboBox>
            </Grid>
            <ScrollViewer Grid.Row="1" VerticalScrollMode="Enabled" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="Settings" Spacing="14" Margin="0,0,12,0">
                    <Border Style="{StaticResource Card}">
                        <StackPanel Spacing="10">
                            <TextBlock x:Name="ProfilesHeading" Style="{StaticResource SectionHeading}" />
                            <Grid ColumnDefinitions="*,*,Auto,Auto" ColumnSpacing="8" VerticalAlignment="Bottom">
                                <ComboBox x:Name="SavedProfiles" HorizontalAlignment="Stretch"
                                          AutomationProperties.AutomationId="SavedProfiles" />
                                <TextBox x:Name="ProfileName" Grid.Column="1" MaxLength="80" AutomationProperties.AutomationId="ProfileName" />
                                <Button x:Name="LoadButton" Grid.Column="2" VerticalAlignment="Bottom" Style="{StaticResource CommandButton}" />
                                <Button x:Name="SaveButton" Grid.Column="3" VerticalAlignment="Bottom" Style="{StaticResource CommandButton}" />
                            </Grid>
                            <Grid ColumnDefinitions="*,*,*,*,*,*" ColumnSpacing="8">
                                <Button x:Name="NewButton" Style="{StaticResource CommandButton}" AutomationProperties.AutomationId="NewProfile" />
                                <Button x:Name="ImportButton" Grid.Column="1" Style="{StaticResource CommandButton}" AutomationProperties.AutomationId="ImportProfile" />
                                <Button x:Name="ExportButton" Grid.Column="2" Style="{StaticResource CommandButton}" AutomationProperties.AutomationId="ExportProfile" />
                                <Button x:Name="FolderButton" Grid.Column="3" Style="{StaticResource CommandButton}" />
                                <TextBlock x:Name="SaveHint" Grid.Column="4" Grid.ColumnSpan="2" VerticalAlignment="Center" Style="{StaticResource SecondaryText}" />
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Padding="16,10">
                        <Grid ColumnDefinitions="*,*,Auto,Auto" ColumnSpacing="12">
                            <CheckBox x:Name="SuppressKeys" MinWidth="0" />
                            <CheckBox x:Name="PauseOnFocus" Grid.Column="1" MinWidth="0" />
                            <CheckBox x:Name="SoundEnabled" Grid.Column="2" MinWidth="0" />
                            <Button x:Name="TestSoundButton" Grid.Column="3" Style="{StaticResource CommandButton}" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel Spacing="10">
                            <TextBlock x:Name="MappingHeading" Style="{StaticResource SectionHeading}" />
                            <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
                                <Button x:Name="RecordButton" Style="{StaticResource CommandButton}" />
                                <Button x:Name="CaptureButton" Grid.Column="1" Style="{StaticResource CommandButton}" />
                                <Button x:Name="CustomizeButton" Grid.Column="2" Style="{StaticResource CommandButton}" />
                                <Button x:Name="ClearButton" Grid.Column="3" Style="{StaticResource CommandButton}" />
                            </Grid>
                            <TextBlock x:Name="MappingHint" Style="{StaticResource SecondaryText}" />
                            <StackPanel x:Name="Mappings" Spacing="4" AutomationProperties.Name="Macro mappings" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            <Grid Grid.Row="2" RowDefinitions="Auto,Auto,Auto" RowSpacing="7">
                <Grid ColumnDefinitions="Auto,Auto,Auto,*" ColumnSpacing="8">
                    <Button x:Name="StartButton" Style="{StaticResource AccentButtonStyle}" MinHeight="34" MinWidth="190" />
                    <Button x:Name="StopButton" Grid.Column="1" Style="{StaticResource CommandButton}"
                            AutomationProperties.AutomationId="StopMacros" />
                    <Button x:Name="TrayButton" Grid.Column="2" Style="{StaticResource CommandButton}"
                            AutomationProperties.AutomationId="MinimizeToTray" />
                    <TextBlock x:Name="Picked" Grid.Column="3" VerticalAlignment="Center" Style="{StaticResource SecondaryText}" />
                </Grid>
                <TextBlock x:Name="CursorPosition" Grid.Row="1" Style="{StaticResource SecondaryText}"
                           AutomationProperties.AutomationId="CursorPosition" />
                <Border Grid.Row="2" Style="{StaticResource Card}" Padding="12,8" MinHeight="36">
                    <TextBlock x:Name="Status" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"
                               AutomationProperties.AutomationId="Status" />
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
